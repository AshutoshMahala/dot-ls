@@ -0,0 +1,9 @@
+//! Local dot-ls structure observation. No retained syntax or recovery tokens.
+const Span = @import("parser_support").location.Span;
+pub const Event = union(enum) {
+    graph: struct { start: Span, name: ?Span },
+    scope: struct { start: Span, name: ?Span },
+    close_scope: Span,
+    close_graph: Span,
+    node: struct { name: Span, end: u64 },
+};
