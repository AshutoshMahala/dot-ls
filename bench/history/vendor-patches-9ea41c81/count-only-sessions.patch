+        /// Count-only resumable parsing. Fixed caller scratch; no AST allocation.
+        /// Results publish capacities only after successful completion.
+        pub const MeasureSession = struct {
+            const Self = @This();
+            const Drivers = union(Variant) {
+                scalar_immediate: EngineFor(.scalar_immediate).MeasureSession,
+                scalar_cancellable: EngineFor(.scalar_cancellable).MeasureSession,
+                scalar_metered: EngineFor(.scalar_metered).MeasureSession,
+                scalar_metered_cancellable: EngineFor(.scalar_metered_cancellable).MeasureSession,
+                block_immediate: EngineFor(.block_immediate).MeasureSession,
+                block_cancellable: EngineFor(.block_cancellable).MeasureSession,
+                block_metered: EngineFor(.block_metered).MeasureSession,
+                block_metered_cancellable: EngineFor(.block_metered_cancellable).MeasureSession,
+            };
+            driver: if (runtime_policy) Drivers else FixedEngine.MeasureSession,
+            pub fn init(source: []const u8, scratch: api.ParseScratch, diagnostics: api.DiagnosticSink, options: FixedParseOptions) Checked(Self) {
+                const effective = if (runtime_policy) try settings(options) else settings(options);
+                return initResolved(source, scratch, diagnostics, effective, options.cancellation);
+            }
+            fn initResolved(source: []const u8, scratch: api.ParseScratch, diagnostics: api.DiagnosticSink, effective: State, hook: Hook) Self {
+                return .{ .driver = if (runtime_policy) switch (variantOf(effective)) {
+                    inline else => |variant| @unionInit(Drivers, @tagName(variant), EngineFor(variant).MeasureSession.init(source, scratch, diagnostics, engineOptions(EngineFor(variant), effective, hook))),
+                } else FixedEngine.MeasureSession.init(source, scratch, diagnostics, engineOptions(FixedEngine, effective, hook)) };
+            }
+            pub fn advance(self: *Self, budget: usize) (if (runtime_policy) error{MeteringDisabled}!api.SessionProgress else api.SessionProgress) {
+                if (runtime_policy) return switch (self.driver) {
+                    inline else => |*driver, variant| if (comptime variant.metered()) driver.advance(budget) else error.MeteringDisabled,
+                };
+                if (!baseline.execution.metering) @compileError("metering is disabled; use run()");
+                return self.driver.advance(budget);
+            }
+            pub fn run(self: *Self) api.MeasureResult {
+                if (runtime_policy) return switch (self.driver) {
+                    inline else => |*driver| driver.run(),
+                };
+                return self.driver.run();
+            }
+            pub fn result(self: *const Self) ?api.MeasureResult {
+                if (runtime_policy) return switch (self.driver) {
+                    inline else => |*driver| driver.result(),
+                };
+                return self.driver.result();
+            }
+            pub fn cancel(self: *Self) api.MeasureResult {
+                if (runtime_policy) return switch (self.driver) {
+                    inline else => |*driver| driver.cancel(),
+                };
+                return self.driver.cancel();
+            }
+            pub fn deinit(self: *Self) void {
+                _ = self.cancel();
+            }
+            pub fn reset(self: *Self, source: []const u8, diagnostics: api.DiagnosticSink, options: FixedParseOptions) Checked(void) {
+                const effective = if (runtime_policy) try settings(options) else settings(options);
+                const scratch = if (runtime_policy) switch (self.driver) {
+                    inline else => |*driver| driver.scratchMemory(),
+                } else self.driver.scratchMemory();
+                _ = self.cancel();
+                self.* = initResolved(source, scratch, diagnostics, effective, options.cancellation);
+            }
+        };
 
