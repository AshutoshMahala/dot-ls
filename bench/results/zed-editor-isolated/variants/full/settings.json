{
  "theme": "One Dark",
  "buffer_font_size": 16,
  "ui_font_size": 14,
  "enable_language_server": false,
  "languages": {
    "DOT (dot-ls)": {
      "enable_language_server": false
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false,
  "autosave": "off",
  "restore_on_startup": "none",
  "on_new_window": "empty_tab",
  "show_edit_predictions": false,
  "file_types": {
    "DOT (dot-ls)": [
      "**/*.dot"
    ]
  },
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  }
}