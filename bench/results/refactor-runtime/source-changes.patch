+    context: *anyopaque,
+    failure: *const fn (*anyopaque, Id, Failure) anyerror!void,
+    pub fn fail(self: Observer, id: Id, reason: Failure) !void {
+        try self.failure(self.context, id, reason);
+    }
+};
