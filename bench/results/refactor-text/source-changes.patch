+        try std.testing.expectEqual(@as(?u32, null), index.byteAt(.{ .line = 99, .character = 0 }));
+        try std.testing.expectEqual(@as(?u32, null), index.byteAt(.{ .line = 0, .character = 99 }));
+    }
