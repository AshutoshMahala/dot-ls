+pub fn run(io: std.Io, allocator: std.mem.Allocator, html_allocator: std.mem.Allocator, reader: *std.Io.Reader, writer: *std.Io.Writer) !bool {
+    var server: Server = .{ .html_allocator = html_allocator, .allocator = allocator, .io = io, .writer = writer };
+    var exit_requested = false;
+    {
+        defer server.deinit();
+        var intake_priority = false;
+        while (try framing.readHeader(reader)) |length| {
+            if (length >= 64 * 1024) {
+                _ = server.syntax_pending.fetchAdd(1, .release);
+                intake_priority = true;
+            }
+            defer server.releaseIntake(&intake_priority);
+            const bytes = try framing.readBody(reader, allocator, length);
+            var packet: ?[]u8 = bytes;
+            defer if (packet) |owned| allocator.free(owned);
+            var parsed: json_message.Message = .{ .allocator = allocator };
+            defer parsed.deinit();
+            const decoding = if (build_options.json_storage == .inplace) parsed.parseInPlace(bytes) else parsed.parse(bytes, if (build_options.json_storage == .buffer) .buffer else .arena);
+            decoding catch |err| {
+                server.mutex.lockUncancelable(io);
+                defer server.mutex.unlock(io);
+                try server.failure(.null, if (err == error.OutOfMemory) @as(i32, lsp.ErrorCode.internal_error) else lsp.ErrorCode.parse_error, if (err == error.OutOfMemory) "Message storage exhausted" else "Parse error");
+                continue;
+            };
+            if (try server.handle(&parsed, &packet)) {
+                exit_requested = true;
+                break;
+            }
+        }
+    }
+    return exit_requested and !server.shutdown;
+}
